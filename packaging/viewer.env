SV_HOST=127.0.0.1
SV_PORT=8080
# Replace with the externally visible HTTPS origin. No trailing slash.
SV_ORIGIN=https://sqlite.example.com
SV_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
SV_AUDIENCE=YOUR-ACCESS-APPLICATION-AUD
# Keys are fetched over HTTPS from the configured Cloudflare team by default.
# Optional externally maintained public key file (also reloaded automatically):
# SV_JWKS=/etc/sqlite-viewer/jwks.json
SV_DATABASES=/etc/sqlite-viewer/databases.json
