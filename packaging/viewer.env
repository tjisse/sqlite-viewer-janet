SV_HOST=127.0.0.1
SV_PORT=8080
# Replace with the externally visible HTTPS origin. No trailing slash.
SV_ORIGIN=https://sqlite.example.com
SV_ISSUER=https://auth.example.com
SV_AUDIENCE=sqlite-viewer
SV_ALGORITHMS=EdDSA
SV_JWKS=/etc/sqlite-viewer/jwks.json
SV_DATABASES=/etc/sqlite-viewer/databases.json
